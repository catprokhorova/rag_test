FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# System deps for lxml/bs4 and llama-cpp-python build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libxml2 \
    libxslt1.1 \
    gcc-12 \
    g++-12 \
    && rm -rf /var/lib/apt/lists/*

ENV CC=gcc-12
ENV CXX=g++-12

COPY requirements.rag.txt /app/requirements.rag.txt
RUN pip install --no-cache-dir -r /app/requirements.rag.txt

COPY src /app/src

# HF caches can be mounted as volumes for faster restarts.
ENV HF_HOME=/hf \
    TRANSFORMERS_CACHE=/hf/transformers \
    HUGGINGFACE_HUB_CACHE=/hf/hub

EXPOSE 8001

CMD ["uvicorn", "src.backend.api.rag.main:app", "--host", "0.0.0.0", "--port", "8001"]
