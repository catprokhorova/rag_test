FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.rag.txt /app/requirements.rag.txt
# sentence-transformers needs torch; install CPU wheel first to avoid nvidia-cuda-* deps.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r /app/requirements.rag.txt

COPY src /app/src

ENV HF_HOME=/hf \
    TRANSFORMERS_CACHE=/hf/transformers \
    HUGGINGFACE_HUB_CACHE=/hf/hub

EXPOSE 8001

CMD ["uvicorn", "src.backend.api.rag.main:app", "--host", "0.0.0.0", "--port", "8001"]
