DATA_DIR=data

# PDF ingestion (local files from manual download)
# Local runs: path to your PDF folder on the host.
PDF_DIR=/pdfs
# Docker Compose: host folder mounted at /pdfs in the rag container (see docker-compose.yml).
PDF_DIR_HOST=/home/you/Downloads/langchain

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=docs_support

# Multilingual embeddings (локально)
EMBED_MODEL=intfloat/multilingual-e5-small

# LM Studio (OpenAI-compatible chat completions)
# Local runs: use the URL shown in LM Studio (often http://127.0.0.1:1234/...).
LLM_CHAT_COMPLETIONS_URL=http://127.0.0.1:1234/v1/chat/completions
# Docker Compose: rag uses host.docker.internal (override if LM Studio is elsewhere).
# LLM_CHAT_COMPLETIONS_URL_DOCKER=http://host.docker.internal:1234/v1/chat/completions
LLM_MODEL=qwen2.5-3b-instruct
LLM_REQUEST_TIMEOUT_S=120
LLM_MAX_NEW_TOKENS=256
LLM_MAX_INPUT_TOKENS=2048
LLM_TEMPERATURE=0.6

# Retrieval
RETRIEVE_TOP_K=8

# Chunking
CHUNK_MAX_CHARS=3000
CHUNK_OVERLAP_CHARS=400
