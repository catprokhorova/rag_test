DATA_DIR=data

# Docs ingestion
DOCS_ROOT=https://docs.langchain.com/oss/python/langchain/overview
DOCS_START_URLS=https://docs.langchain.com/oss/python/langchain/overview,https://docs.langchain.com/oss/python/langgraph/overview
DOCS_ALLOWED_PREFIXES=https://docs.langchain.com/oss/python/langchain/,https://docs.langchain.com/oss/python/langgraph/

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=docs_support

# Multilingual embeddings (локально)
EMBED_MODEL=intfloat/multilingual-e5-small

# LM Studio (OpenAI-compatible chat completions)
LLM_CHAT_COMPLETIONS_URL=http://host:port/v1/chat/completions
LLM_MODEL=qwen2.5-3b-instruct
LLM_REQUEST_TIMEOUT_S=120
LLM_MAX_NEW_TOKENS=256
LLM_MAX_INPUT_TOKENS=2048
LLM_TEMPERATURE=0.6

# Retrieval
RETRIEVE_TOP_K=8

# Chunking
CHUNK_MAX_CHARS=3000
CHUNK_OVERLAP_CHARS=400
