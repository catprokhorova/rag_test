# PDFs live at data/*.pdf; chunk JSONL at data/processed/
DATA_DIR=data
# Optional override if PDFs are not under DATA_DIR:
# PDF_DIR=/path/to/pdfs

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=docs_support

# Multilingual embeddings (локально)
EMBED_MODEL=intfloat/multilingual-e5-small

# Yandex Cloud AI Studio (OpenAI-compatible Responses API)
YANDEX_CLOUD_FOLDER=b1g4o1j024hb54bou17c
YANDEX_CLOUD_API_KEY=***
YANDEX_CLOUD_MODEL=aliceai-llm-flash/latest
# YANDEX_CLOUD_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_REQUEST_TIMEOUT_S=120
LLM_MAX_NEW_TOKENS=256
LLM_MAX_INPUT_TOKENS=2048
LLM_TEMPERATURE=0.3

# Retrieval
RETRIEVE_TOP_K=8
RETRIEVE_SCORE_THRESHOLD=0.75

# Chunking
CHUNK_MAX_CHARS=3000
CHUNK_OVERLAP_CHARS=400

# Observability — Langfuse (optional)
LANGFUSE_PUBLIC_KEY=***
LANGFUSE_SECRET_KEY=***
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Observability — Arize Phoenix (optional; local UI at http://localhost:6006)
# Local process on host:
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=docs-rag
# PHOENIX_OTEL_PROTOCOL=http/protobuf
# PHOENIX_AUTO_INSTRUMENT=true
# From Docker rag service, use host gateway instead of localhost:
# PHOENIX_COLLECTOR_ENDPOINT=http://host.docker.internal:6006

# Auth
AUTH_TOKEN=***

# Streamlit frontend (talks to the facade API)
# Local uvicorn: http://localhost:8000
# Docker Compose from the host: http://localhost:8002
# BACKEND_URL=http://localhost:8000
# FRONTEND_CHAT_TIMEOUT_S=120
